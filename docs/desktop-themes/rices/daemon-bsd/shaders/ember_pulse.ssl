// Sable Shading Language (SSL) — DESKTOP.md §4.7.4
// Kind: fill (inputs: uv, size, base_color, time)

fn shade_fill(uv: vec2<f32>, _size: vec2<f32>, _base: vec4<f32>, time: f32) -> vec4<f32> {
    let pulse = 0.5 + 0.5 * sin(time * 4.5);
    let crimson = vec3<f32>(0.82, 0.16, 0.14);
    let amber   = vec3<f32>(0.96, 0.62, 0.12);
    let col = mix(crimson, amber, pulse * (1.0 - uv.y * 0.4));
    return vec4<f32>(col, 1.0);
}
