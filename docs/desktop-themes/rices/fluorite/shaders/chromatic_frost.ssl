// Sable Shading Language (SSL) — DESKTOP.md §4.7.4
// Kind: backdrop (inputs: backdrop_tex, node_sdf, uv, size, time)

struct BackdropIn {
    uv: vec2<f32>,
    size: vec2<f32>,
    sdf: f32,
    time: f32,
};

fn shade_backdrop(in: BackdropIn) -> vec4<f32> {
    let rim = clamp(1.0 + in.sdf / 12.0, 0.0, 1.0);
    let disp = (in.uv - vec2<f32>(0.5, 0.5)) * (rim * 0.004);
    let r = sample_backdrop(in.uv + disp).r;
    let g = sample_backdrop(in.uv).g;
    let b = sample_backdrop(in.uv - disp).b;
    return vec4<f32>(r, g, b, 1.0);
}
