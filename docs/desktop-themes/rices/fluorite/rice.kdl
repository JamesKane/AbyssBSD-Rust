// docs/desktop-themes/rices/fluorite/rice.kdl
// Candidate 07: Iridescent Frosted Glass (Maximalist Showcase)
// Compliant with DESKTOP.md §7.3 & §4.7.2 (async compute blur pyramid + SDF shadows)

theme {
    token "base"         (color)"oklch(0.17 0.04 275)"
    token "surface"      (color)"oklch(0.24 0.05 275 / 0.55)"
    token "surface.elev" (color)"oklch(0.29 0.06 280 / 0.68)"
    token "text"         (color)"oklch(0.96 0.01 275)"
    token "muted"        (color)"oklch(0.72 0.04 275)"
    token "accent"       (color)"oklch(0.76 0.17 330)"
    token "accent.alt"   (color)"oklch(0.80 0.14 190)"
    token "warn"         (color)"oklch(0.80 0.16 70)"
    token "radius"       (px)16
    token "font.ui"      "Inter"
    token "font.mono"    "JetBrains Mono"

    style "prism-island" {
        background "@surface"
        backdrop blur=(px)32 saturation=1.40 shader="shaders/chromatic_frost.ssl"
        radius (px)999
        border (px)1 "@accent" alpha=0.38
        shadow elevation=(px)28 color="oklch(0.06 0.04 275 / 0.60)"
    }

    style "workspace-button" {
        padding (px)5 (px)12
        radius (px)999
        text-color "@muted"
        state "active" { fill shader="shaders/aurora_mesh.ssl" ; text-color "@base" }
        state "hover"  { background "@accent" alpha=0.25 ; text-color "@text" }
        transition "background" (ms)150 curve="spring(300, 24)"
    }
}

shader {
    backdrop "chromatic_frost" file="shaders/chromatic_frost.ssl" budget=(us)320
    fill "aurora_mesh" file="shaders/aurora_mesh.ssl" budget=(us)180
}

animation {
    window-open      curve="spring(260, 20)" duration=(ms)220
    window-close     curve="ease-in"         duration=(ms)150
    window-move      curve="spring(300, 24)" duration=(ms)190
    workspace-switch curve="spring(260, 22)" duration=(ms)240
}

layout {
    default "tile"
    gap outer=(px)16 inner=(px)12
    border width=(px)1 active="@accent" inactive="oklch(0.45 0.06 275 / 0.35)"
    corner-radius "@radius"
    shadow elevation=(px)32 color="oklch(0.05 0.04 275 / 0.65)"
}

panel "top" {
    anchor "top"
    margin top=(px)10 left=(px)16 right=(px)16
    height (px)38
    style "prism-island"
    slot "start"  { facet "sable-workspaces" ; facet "sable-window-title" }
    slot "center" { facet "sable-media" ; facet "sable-clock" format="%a %H:%M" }
    slot "end"    { facet "sable-tray" ; facet "sable-audio" ; facet "sable-network" ; facet "sable-battery" }
}

dock "bottom" {
    anchor "bottom"
    margin bottom=(px)10
    height (px)54
    style "prism-island"
    slot "pinned" { facet "sable-dock" }
}
