// docs/desktop-themes/rices/hadal/rice.kdl
// Candidate 01: Hadal Bioluminescence (Flagship Default)
// Compliant with DESKTOP.md §7.3 (theme, panel, dock, layout, animation, shader only)

theme {
    token "base"         (color)"oklch(0.13 0.02 255)"
    token "surface"      (color)"oklch(0.18 0.03 255 / 0.78)"
    token "surface.elev" (color)"oklch(0.22 0.035 255 / 0.86)"
    token "text"         (color)"oklch(0.93 0.02 240)"
    token "muted"        (color)"oklch(0.62 0.03 250)"
    token "accent"       (color)"oklch(0.78 0.16 205)"
    token "accent.alt"   (color)"oklch(0.68 0.18 285)"
    token "warn"         (color)"oklch(0.75 0.17 45)"
    token "danger"       (color)"oklch(0.65 0.22 25)"
    token "radius"       (px)10
    token "radius.pill"  (px)999
    token "font.ui"      "Inter"
    token "font.mono"    "JetBrains Mono"

    style "glass" {
        background "@surface"
        backdrop blur=(px)24 saturation=1.25 shader="shaders/caustic_glass.ssl"
        radius "@radius"
        border (px)1 "@accent" alpha=0.28
        shadow elevation=(px)18 color="oklch(0.05 0.02 255 / 0.65)"
    }

    style "pill-cluster" {
        background "@surface.elev"
        radius "@radius.pill"
        padding (px)3 (px)8
        border (px)1 "@accent" alpha=0.18
    }

    style "workspace-button" {
        padding (px)4 (px)10
        radius (px)6
        text-color "@muted"
        state "active" { background "@accent" ; text-color "@base" }
        state "hover"  { background "@accent" alpha=0.22 ; text-color "@text" }
        transition "background" (ms)120 curve="ease-out"
    }

    style "notification" {
        background "@surface.elev"
        backdrop blur=(px)28 saturation=1.3
        radius "@radius"
        border (px)1 "@accent" alpha=0.40
        shadow elevation=(px)24 color="oklch(0.04 0.02 255 / 0.75)"
    }
}

shader {
    backdrop "caustic_glass" file="shaders/caustic_glass.ssl" budget=(us)250
    transition "pressure_wave" file="shaders/pressure_wave.ssl" budget=(us)300
}

animation {
    window-open      curve="spring(320, 28)" duration=(ms)160
    window-close     curve="ease-in"         duration=(ms)110
    window-move      curve="spring(380, 32)" duration=(ms)140
    workspace-switch shader="pressure_wave"  duration=(ms)160
}

layout {
    default "tile"
    gap outer=(px)10 inner=(px)6
    border width=(px)1 active="@accent" inactive="oklch(0.30 0.02 255 / 0.45)"
    corner-radius "@radius"
    shadow elevation=(px)20 color="oklch(0.04 0.02 255 / 0.70)"
}

panel "top" {
    anchor "top"
    margin top=(px)8 left=(px)10 right=(px)10
    height (px)34
    style "glass"
    slot "start"  { facet "sable-workspaces" ; facet "sable-window-title" }
    slot "center" { facet "sable-clock" format="%a %b %d  %H:%M" ; facet "sable-media" }
    slot "end"    { facet "sable-tray" ; facet "sable-audio" ; facet "sable-network" ; facet "sable-battery" }
}
