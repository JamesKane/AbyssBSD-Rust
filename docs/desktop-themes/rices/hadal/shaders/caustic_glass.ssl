// Sable Shading Language (SSL) — DESKTOP.md §4.7.4
// Kind: backdrop (inputs: backdrop_tex, node_sdf, uv, size, time)

struct BackdropIn {
    uv: vec2<f32>,
    size: vec2<f32>,
    sdf: f32,
    time: f32,
};

fn shade_backdrop(in: BackdropIn) -> vec4<f32> {
    // Subtle normal-mapped edge refraction near rounded SDF border (-8px..0px)
    let edge_band = clamp(1.0 + in.sdf / 8.0, 0.0, 1.0);
    let caustic_wave = sin(in.uv.x * 18.0 + in.time * 0.6) * cos(in.uv.y * 14.0 - in.time * 0.4);
    let offset = vec2<f32>(caustic_wave, -caustic_wave) * (edge_band * 0.0035);
    let bg = sample_backdrop(in.uv + offset);

    // Specular bioluminescent rim highlight on the top edge
    let top_bias = clamp(1.0 - in.uv.y * 1.6, 0.0, 1.0);
    let rim = edge_band * top_bias * 0.14;
    let biolum = vec3<f32>(0.18, 0.85, 0.96) * rim;

    return vec4<f32>(bg.rgb + biolum, bg.a);
}
