// docs/desktop-themes/rices/pelagic-day/rice.kdl
// Candidate 02: Pelagic Daylight (High-Contrast Light Mode)
// Compliant with DESKTOP.md §7.3 (theme, panel, dock, layout, animation, shader only)

theme {
    token "base"         (color)"oklch(0.96 0.01 95)"
    token "surface"      (color)"oklch(0.99 0.005 95 / 0.88)"
    token "surface.elev" (color)"oklch(1.00 0.0 0 / 0.94)"
    token "text"         (color)"oklch(0.20 0.03 255)"
    token "muted"        (color)"oklch(0.48 0.03 255)"
    token "accent"       (color)"oklch(0.52 0.16 235)"
    token "accent.alt"   (color)"oklch(0.56 0.14 185)"
    token "warn"         (color)"oklch(0.60 0.19 30)"
    token "radius"       (px)8
    token "font.ui"      "Inter"
    token "font.mono"    "JetBrains Mono"

    style "chart-paper" {
        background "@surface"
        backdrop blur=(px)16 saturation=1.10
        fill shader="shaders/paper_grain.ssl"
        radius "@radius"
        border (px)1 "oklch(0.20 0.03 255 / 0.14)"
        shadow elevation=(px)12 color="oklch(0.20 0.03 255 / 0.10)"
    }

    style "workspace-button" {
        padding (px)4 (px)9
        radius (px)5
        text-color "@muted"
        state "active" { background "@accent" ; text-color "@surface.elev" }
        state "hover"  { background "@accent" alpha=0.12 ; text-color "@text" }
        transition "background" (ms)110 curve="ease-out"
    }
}

shader {
    fill "paper_grain" file="shaders/paper_grain.ssl" budget=(us)120
}

animation {
    window-open      curve="spring(340, 30)" duration=(ms)170
    window-close     curve="ease-in"         duration=(ms)110
    workspace-switch curve="spring(300, 28)" duration=(ms)200
}

layout {
    default "columns"
    gap outer=(px)12 inner=(px)8
    border width=(px)1 active="@accent" inactive="oklch(0.20 0.03 255 / 0.16)"
    corner-radius "@radius"
    shadow elevation=(px)14 color="oklch(0.20 0.03 255 / 0.12)"
}

panel "top" {
    anchor "top"
    height (px)32
    style "chart-paper"
    slot "start"  { facet "sable-workspaces" ; facet "sable-window-title" }
    slot "center" { facet "sable-clock" format="%a %d %b  %H:%M" }
    slot "end"    { facet "sable-tray" ; facet "sable-audio" ; facet "sable-network" ; facet "sable-battery" }
}

dock "bottom" {
    anchor "bottom"
    auto-hide #true
    height (px)48
    style "chart-paper"
    slot "pinned" { facet "sable-dock" }
}
