// Sable Shading Language (SSL) — DESKTOP.md §4.7.4
// Kind: fill (inputs: uv, size, base_color, time)

fn hash21(p: vec2<f32>) -> f32 {
    let q = fract(p * vec2<f32>(123.34, 456.21));
    let d = dot(q, q + vec2<f32>(45.32, 45.32));
    return fract((q.x + d) * (q.y + d));
}

fn shade_fill(uv: vec2<f32>, size: vec2<f32>, base_color: vec4<f32>, _time: f32) -> vec4<f32> {
    let px = floor(uv * size);
    let grain = (hash21(px) - 0.5) * 0.014;
    return vec4<f32>(clamp(base_color.rgb + vec3<f32>(grain), vec3<f32>(0.0), vec3<f32>(1.0)), base_color.a);
}
