// docs/desktop-themes/rices/benthic-eink/rice.kdl
// Candidate 10: Zero-Strain Monochrome (Night / E-Ink Focus)
// Compliant with DESKTOP.md §7.3 & §4.7.4 (Bayer dither + blue-light roll-off `post` shader)

theme {
    token "base"         (color)"oklch(0.16 0.005 100)"
    token "surface"      (color)"oklch(0.20 0.005 100)"
    token "surface.elev" (color)"oklch(0.25 0.005 100)"
    token "text"         (color)"oklch(0.82 0.01 95)"
    token "muted"        (color)"oklch(0.50 0.005 100)"
    token "accent"       (color)"oklch(0.88 0.02 95)"
    token "warn"         (color)"oklch(0.75 0.10 60)"
    token "radius"       (px)4
    token "font.ui"      "JetBrains Mono"
    token "font.mono"    "JetBrains Mono"

    style "eink-strip" {
        background "@surface"
        radius "@radius"
        border (px)1 "@muted" alpha=0.40
    }

    style "workspace-button" {
        padding (px)3 (px)8
        radius (px)2
        text-color "@muted"
        state "active" { background "@accent" ; text-color "@base" }
        state "hover"  { background "@surface.elev" ; text-color "@text" }
    }
}

shader {
    post "bayer_dither" file="shaders/bayer_dither.ssl" budget=(us)180
}

animation {
    window-open      curve="ease-out" duration=(ms)80
    window-close     curve="ease-in"  duration=(ms)60
    workspace-switch curve="linear"   duration=(ms)60
}

layout {
    default "monocle"
    gap outer=(px)14 inner=(px)8
    border width=(px)1 active="@accent" inactive="oklch(0.30 0.005 100)"
    corner-radius "@radius"
}

panel "top" {
    anchor "top"
    margin top=(px)8 left=(px)14 right=(px)14
    height (px)28
    style "eink-strip"
    slot "start"  { facet "sable-workspaces" ; facet "sable-window-title" }
    slot "center" { facet "sable-clock" format="%H:%M" }
    slot "end"    { facet "sable-battery" }
}
