// docs/desktop-themes/rices/esports-zero/rice.kdl
// Candidate 04: 0ms Tournament (Competitive Gaming / Direct Scanout)
// Compliant with DESKTOP.md §7.3 & §5.8 latency targets (zero blur, zero animations, direct-scanout ready)

theme {
    token "base"         (color)"oklch(0.08 0.0 0)"
    token "surface"      (color)"oklch(0.14 0.0 0)"
    token "surface.elev" (color)"oklch(0.19 0.0 0)"
    token "text"         (color)"oklch(0.92 0.0 0)"
    token "muted"        (color)"oklch(0.55 0.0 0)"
    token "accent"       (color)"oklch(0.86 0.21 142)"
    token "warn"         (color)"oklch(0.82 0.18 85)"
    token "radius"       (px)0
    token "font.ui"      "JetBrains Mono"
    token "font.mono"    "JetBrains Mono"

    style "flat-hud" {
        background "@surface"
        radius (px)0
        border (px)1 "@accent" alpha=0.60
    }

    style "workspace-button" {
        padding (px)4 (px)6
        radius (px)0
        text-color "@muted"
        state "active" { background "@accent" ; text-color "@base" }
        state "hover"  { background "@surface.elev" ; text-color "@text" }
    }
}

animation {
    window-open      curve="linear" duration=(ms)0
    window-close     curve="linear" duration=(ms)0
    window-move      curve="linear" duration=(ms)0
    workspace-switch curve="linear" duration=(ms)0
}

layout {
    default "monocle"
    gap outer=(px)0 inner=(px)2
    border width=(px)1 active="@accent" inactive="oklch(0.22 0.0 0)"
    corner-radius (px)0
}

panel "left" {
    anchor "left"
    auto-hide #true
    width (px)28
    style "flat-hud"
    slot "start"  { facet "sable-workspaces" }
    slot "center" { facet "sable-sysmon" }
    slot "end"    { facet "sable-audio" ; facet "sable-clock" format="%H:%M" }
}
