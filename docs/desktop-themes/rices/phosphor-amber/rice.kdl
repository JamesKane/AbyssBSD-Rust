// docs/desktop-themes/rices/phosphor-amber/rice.kdl
// Candidate 06: P3 Vector Terminal (Retro-Hardware CRT)
// Compliant with DESKTOP.md §7.3 & §4.7.4 (`post` shader in linear R16G16B16A16_SFLOAT)

theme {
    token "base"         (color)"oklch(0.11 0.02 70)"
    token "surface"      (color)"oklch(0.15 0.03 70 / 0.92)"
    token "surface.elev" (color)"oklch(0.19 0.04 72 / 0.96)"
    token "text"         (color)"oklch(0.84 0.17 78)"
    token "muted"        (color)"oklch(0.55 0.11 75)"
    token "accent"       (color)"oklch(0.90 0.19 82)"
    token "warn"         (color)"oklch(0.74 0.20 45)"
    token "radius"       (px)2
    token "font.ui"      "JetBrains Mono"
    token "font.mono"    "JetBrains Mono"

    style "vt-bezel" {
        background "@surface"
        radius "@radius"
        border (px)1 "@accent" alpha=0.65
        shadow elevation=(px)10 color="oklch(0.84 0.17 78 / 0.12)"
    }

    style "workspace-button" {
        padding (px)3 (px)8
        radius (px)2
        text-color "@muted"
        state "active" { background "@accent" ; text-color "@base" }
        state "hover"  { background "@accent" alpha=0.20 ; text-color "@accent" }
    }
}

shader {
    post "crt_aperture" file="shaders/crt_aperture.ssl" budget=(us)350
    transition "phosphor_decay" file="shaders/phosphor_decay.ssl" budget=(us)250
}

animation {
    window-open      curve="ease-out"        duration=(ms)120
    window-close     shader="phosphor_decay" duration=(ms)140
    workspace-switch shader="phosphor_decay" duration=(ms)140
}

layout {
    default "tile"
    gap outer=(px)6 inner=(px)6
    border width=(px)1 active="@accent" inactive="oklch(0.42 0.09 75 / 0.55)"
    corner-radius "@radius"
}

panel "top" {
    anchor "top"
    margin top=(px)6 left=(px)6 right=(px)6
    height (px)28
    style "vt-bezel"
    slot "start"  { facet "sable-workspaces" ; facet "sable-window-title" }
    slot "center" { facet "sable-sysmon" }
    slot "end"    { facet "sable-audio" ; facet "sable-network" ; facet "sable-clock" format="DEC-VT  %H:%M:%S" }
}
