// docs/desktop-themes/rices/solaris-cde/rice.kdl
// Candidate 09: Neo-Workstation Bevel (90s UNIX Workstation Reimagined)
// Compliant with DESKTOP.md §7.3 & §4.7.3 (analytic SDF bevel fill shader, zero bitmap assets)

theme {
    token "base"         (color)"oklch(0.38 0.05 235)"
    token "surface"      (color)"oklch(0.76 0.02 75)"
    token "surface.elev" (color)"oklch(0.82 0.02 75)"
    token "text"         (color)"oklch(0.18 0.01 250)"
    token "muted"        (color)"oklch(0.42 0.02 250)"
    token "accent"       (color)"oklch(0.50 0.13 265)"
    token "active-title" (color)"oklch(0.62 0.14 45)"
    token "radius"       (px)0
    token "font.ui"      "Inter"
    token "font.mono"    "JetBrains Mono"

    style "cde-bevel" {
        background "@surface"
        fill shader="shaders/sdf_chisel.ssl"
        radius (px)0
        border (px)1 "oklch(0.22 0.01 250)"
        shadow elevation=(px)8 color="oklch(0.12 0.02 235 / 0.45)"
    }

    style "workspace-button" {
        padding (px)5 (px)12
        radius (px)0
        fill shader="shaders/sdf_chisel.ssl"
        text-color "@text"
        state "active" { background "@active-title" ; text-color "oklch(0.97 0.01 80)" }
        state "hover"  { background "@surface.elev" ; text-color "@text" }
    }
}

shader {
    fill "sdf_chisel" file="shaders/sdf_chisel.ssl" budget=(us)110
}

animation {
    window-open      curve="ease-out" duration=(ms)110
    window-close     curve="ease-in"  duration=(ms)90
    workspace-switch curve="ease-out" duration=(ms)120
}

layout {
    default "float"
    gap outer=(px)8 inner=(px)8
    border width=(px)2 active="@active-title" inactive="@surface"
    corner-radius (px)0
}

panel "cde-front" {
    anchor "bottom"
    margin bottom=(px)6 left=(px)120 right=(px)120
    height (px)46
    style "cde-bevel"
    slot "start"  { facet "sable-clock" format="%H:%M" ; facet "sable-sysmon" }
    slot "center" { facet "sable-workspaces" }
    slot "end"    { facet "sable-audio" ; facet "sable-network" ; facet "sable-tray" }
}
