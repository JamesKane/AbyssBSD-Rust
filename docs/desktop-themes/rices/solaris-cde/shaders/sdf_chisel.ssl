// Sable Shading Language (SSL) — DESKTOP.md §4.7.4
// Kind: fill (inputs: uv, size, base_color, time)

fn shade_fill(uv: vec2<f32>, size: vec2<f32>, base_color: vec4<f32>, _time: f32) -> vec4<f32> {
    let px = uv * size;
    let bw = 2.0;
    let is_top_or_left = step(px.x, bw) + step(px.y, bw);
    let is_bot_or_right = step(size.x - bw, px.x) + step(size.y - bw, px.y);
    let hi = clamp(is_top_or_left, 0.0, 1.0) * 0.16;
    let lo = clamp(is_bot_or_right, 0.0, 1.0) * 0.22;
    return vec4<f32>(clamp(base_color.rgb + vec3<f32>(hi - lo), vec3<f32>(0.0), vec3<f32>(1.0)), base_color.a);
}
