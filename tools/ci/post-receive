#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
#
# CI hook for the build server's bare repository (docs/BUILD-AND-TEST.md §5).
# Install as ~/abyss/repo.git/hooks/post-receive. CI runs at milestone
# exits, not on every push: pushing a tag `exit/<milestone>` (exit/u6,
# exit/p6) runs `cargo xtask test --tier all` on the tagged commit in a
# persistent work tree (so target/ is reused) and writes
# ~/abyss/ci/<time>-<milestone>-<rev>.log ending in PASS or FAIL. Pushes
# to main only update the repository. The push returns immediately (the
# job closes every descriptor git passed in); runs are serialised with a
# lock file.

ci="$HOME/abyss/ci"
work="$HOME/abyss/ci-work"
repo="$(cd "${GIT_DIR:-.}" && pwd)"
# Git runs hooks with GIT_DIR set; it must not leak into the work tree's git.
unset GIT_DIR
mkdir -p "$ci"

zero=0000000000000000000000000000000000000000
while read -r _old new ref; do
	case "$ref" in
	refs/tags/exit/*) ;;
	*) continue ;;
	esac
	# A deleted tag tests nothing.
	[ "$new" = "$zero" ] && continue
	name="${ref#refs/tags/exit/}"
	# An annotated tag names its commit.
	rev="$(git --git-dir="$repo" rev-parse "$new^{commit}")"
	log="$ci/$(date +%Y%m%d-%H%M%S)-$(echo "$name" | tr / -)-$(echo "$rev" | cut -c1-12).log"
	echo "ci: exit $name: testing $rev, log $log"
	nohup sh -c '
		lockf -k "$1/.lock" sh -c "
			set -e
			[ -d \"$2/.git\" ] || git clone -q \"$3\" \"$2\"
			cd \"$2\"
			git fetch -q origin
			git checkout -qf \"$4\"
			git clean -fdq -e target -e build
			PATH=\$HOME/.cargo/bin:\$PATH cargo xtask test --tier all
		"
		case $? in
		0) echo PASS ;;
		*) echo FAIL ;;
		esac
	' ci "$ci" "$work" "$repo" "$rev" >"$log" 2>&1 </dev/null \
		3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
done
