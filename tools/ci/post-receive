#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
#
# CI hook for the build server's bare repository (docs/BUILD-AND-TEST.md §5).
# Install as ~/abyss/repo.git/hooks/post-receive. Each push to main runs
# `cargo xtask test` in a persistent work tree (so target/ is reused) and
# writes ~/abyss/ci/<time>-<rev>.log ending in PASS or FAIL. The push
# returns immediately (the job closes every descriptor git passed in);
# runs are serialised with a lock file. A run that gets the lock after
# main has moved on ends SUPERSEDED without testing: the newer push's run
# covers it, so a burst of pushes costs one run.

ci="$HOME/abyss/ci"
work="$HOME/abyss/ci-work"
repo="$(cd "${GIT_DIR:-.}" && pwd)"
# Git runs hooks with GIT_DIR set; it must not leak into the work tree's git.
unset GIT_DIR
mkdir -p "$ci"

while read -r _old new ref; do
	[ "$ref" = "refs/heads/main" ] || continue
	log="$ci/$(date +%Y%m%d-%H%M%S)-$(echo "$new" | cut -c1-12).log"
	echo "ci: testing $new, log $log"
	nohup sh -c '
		lockf -k "$1/.lock" sh -c "
			[ \"\$(git --git-dir=\"$3\" rev-parse refs/heads/main)\" = \"$4\" ] || exit 3
			set -e
			[ -d \"$2/.git\" ] || git clone -q \"$3\" \"$2\"
			cd \"$2\"
			git fetch -q origin
			git checkout -qf \"$4\"
			git clean -fdq -e target -e build
			PATH=\$HOME/.cargo/bin:\$PATH cargo xtask test --tier all
		"
		case $? in
		0) echo PASS ;;
		3) echo SUPERSEDED ;;
		*) echo FAIL ;;
		esac
	' ci "$ci" "$work" "$repo" "$new" >"$log" 2>&1 </dev/null \
		3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
done
