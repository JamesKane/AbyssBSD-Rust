                0xFE, 
                NCPU, 
            }
        })
        Method (_PSD, 0, NotSerialized)  // _PSD: Power State Dependencies
        {
            Local0 = P0ID /* \P0ID */
            Local1 = P0BM /* \P0BM */
            If ((WSME == 0x00))
            {
                Local0 >>= 0x05
                Local2 = 0x10
            }
            Else
            {
                Local0 >>= 0x06
                Local2 = 0x14
            }

            DOMN = Local0
            Local0 = 0x00
            While (Local2)
            {
                If (((Local1 & 0x01) == 0x01))
                {
                    Local0 += 0x01
                }

                Local1 >>= 0x01
                Local2 -= 0x01
            }

            NCPU = Local0
            If ((((TYPE & 0x0820) == 0x0820) && (HWAL == 0x00)))
            {
                Return (PSDE) /* \_PR_.CP08.PSDE */
            }

            If ((((TYPE & 0x0820) == 0x20) && (HWAL == 0x01)))
            {
                Return (PSDD) /* \_PR_.CP08.PSDD */
            }

            Return (PSDC) /* \_PR_.CP08.PSDC */
        }

        Method (_PDC, 1, NotSerialized)  // _PDC: Processor Driver Capabilities
        {
            CreateDWordField (Arg0, 0x08, CAPA)
            CreateDWordField (Arg0, 0x00, REVS)
            CreateDWordField (Arg0, 0x04, SIZE)
            Local0 = SizeOf (Arg0)
            Local1 = (Local0 - 0x08)
            CreateField (Arg0, 0x40, (Local1 * 0x08), TEMP)
            Name (STS0, Buffer (0x04)
            {
                 0x00, 0x00, 0x00, 0x00                           // ....
            })
            Concatenate (STS0, TEMP, Local2)
            _OSC (ToUUID ("4077a616-290c-47be-9ebd-d87058713953") /* Unknown UUID */, REVS, SIZE, Local2)
        }

        Method (_OSC, 4, NotSerialized)  // _OSC: Operating System Capabilities
        {
            CreateDWordField (Arg3, 0x04, CAPA)
            TYPE = CAPA /* \_PR_.CP08._OSC.CAPA */
            CreateDWordField (Arg3, 0x00, STS0)
            CreateDWordField (Arg3, 0x04, CAP0)
            CreateDWordField (Arg0, 0x00, IID0)
            CreateDWordField (Arg0, 0x04, IID1)
            CreateDWordField (Arg0, 0x08, IID2)
            CreateDWordField (Arg0, 0x0C, IID3)
            Name (UID0, ToUUID ("4077a616-290c-47be-9ebd-d87058713953") /* Unknown UUID */)
            CreateDWordField (UID0, 0x00, EID0)
            CreateDWordField (UID0, 0x04, EID1)
            CreateDWordField (UID0, 0x08, EID2)
            CreateDWordField (UID0, 0x0C, EID3)
            If (!(((IID0 == EID0) && (IID1 == EID1)) && ((
                IID2 == EID2) && (IID3 == EID3))))
            {
                STS0 [0x00] = 0x06
                Return (Arg3)
            }

            If ((Arg1 != 0x01))
            {
                STS0 [0x00] = 0x0A
                Return (Arg3)
            }

            If ((HWAL == 0x01))
            {
                Local0 = 0x03FF
            }
            Else
            {
                Local0 = 0x0BFF
            }

            If ((STS0 & 0x01))
            {
                CAP0 &= Local0
                Return (Arg3)
            }

            CAP0 &= Local0
            TYPE = CAP0 /* \_PR_.CP08._OSC.CAP0 */
            Return (Arg3)
        }

