                    Notify (\_PR.CP0K, 0x81) // C-State Change
                }
            }

            If ((PDCL & 0x08))
            {
                Notify (\_PR.CP0L, 0x80) // Performance Capability Change
                If ((PDCL & 0x10))
                {
                    Notify (\_PR.CP0L, 0x81) // C-State Change
                }
            }

            If ((PDCM & 0x08))
            {
                Notify (\_PR.CP0M, 0x80) // Performance Capability Change
                If ((PDCF & 0x10))
                {
                    Notify (\_PR.CP0M, 0x81) // C-State Change
                }
            }

            If ((PDCN & 0x08))
            {
                Notify (\_PR.CP0N, 0x80) // Performance Capability Change
                If ((PDCF & 0x10))
                {
                    Notify (\_PR.CP0N, 0x81) // C-State Change
                }
            }
        }
        Else
        {
            Notify (\_PR.CP00, 0x80) // Performance Capability Change
            Notify (\_PR.CP00, 0x81) // C-State Change
        }
    }

    Method (TRAP, 2, Serialized)
    {
        SMIF = Arg1
        If ((Arg0 == \TRTP))
