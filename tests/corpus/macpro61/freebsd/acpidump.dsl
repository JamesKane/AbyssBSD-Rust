                \_SB.PCI0.PEG0.BR00.BR10.RMCW ()
                \_SB.PCI0.PEG0.BR00.BR11.RMCW ()
                \_SB.PCI0.PEG0.BR00.BR12.RMCW ()
            }
        }

        PNOT ()
        Return (Package (0x02)
        {
            0x00, 
            0x00
        })
    }

