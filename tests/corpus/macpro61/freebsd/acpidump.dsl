        Method (_PSD, 0, NotSerialized)  // _PSD: Power State Dependencies
        {
            Local0 = P0ID /* \P0ID */
            Local1 = P0BM /* \P0BM */
            If ((WSME == 0x00))
            {
                Local0 >>= 0x05
                Local2 = 0x10
            }
            Else
            {
                Local0 >>= 0x06
                Local2 = 0x14
            }

            DOMN = Local0
            Local0 = 0x00
            While (Local2)
            {
                If (((Local1 & 0x01) == 0x01))
                {
                    Local0 += 0x01
                }

                Local1 >>= 0x01
                Local2 -= 0x01
            }

            NCPU = Local0
            If ((((TYPE & 0x0820) == 0x0820) && (HWAL == 0x00)))
            {
                Return (PSDE) /* \_PR_.CP0A.PSDE */
            }

            If ((((TYPE & 0x0820) == 0x20) && (HWAL == 0x01)))
            {
                Return (PSDD) /* \_PR_.CP0A.PSDD */
            }

            Return (PSDC) /* \_PR_.CP0A.PSDC */
        }

