    Method (_PTS, 1, NotSerialized)  // _PTS: Prepare To Sleep
    {
        P80D = 0x00
        P8XH (0x00, Arg0)
        \_SB.PCI0.LPCB.EC.ECSS = Arg0
        If (!OSDW ())
        {
            If ((Arg0 == 0x03))
            {
                PCIW = 0x00
                If ((PCWS == 0x01))
                {
                    PCWS = 0x01
                }
            }

            GP41 = 0x01
            GP40 = 0x01
        }

        If ((!OSDW () && (Arg0 >= 0x04)))
        {
            \_SB.PCI0.LPCB.EC.EWLO = 0x00
        }

        If ((Arg0 >= 0x05))
        {
            \_SB.PCI0.PEG0.BR00.BR10.UFS0.LSTX (0x00, 0x01)
            \_SB.PCI0.PEG0.BR00.BR10.UFS0.LSTX (0x01, 0x01)
            \_SB.PCI0.PEG0.BR00.BR11.UFS1.LSTX (0x00, 0x01)
            \_SB.PCI0.PEG0.BR00.BR11.UFS1.LSTX (0x01, 0x01)
            \_SB.PCI0.PEG0.BR00.BR12.UFS2.LSTX (0x00, 0x01)
            \_SB.PCI0.PEG0.BR00.BR12.UFS2.LSTX (0x01, 0x01)
        }
    }

    Method (_WAK, 1, NotSerialized)  // _WAK: Wake
    {
        P8XH (0x00, 0x00)
        If (!OSDW ())
        {
            Notify (\_SB.PWRB, 0x02) // Device Wake
            Notify (\_SB.PCI0.PEG0, 0x02) // Device Wake
            Notify (\_SB.PCI0.PEG0.BR00.BR13.XHC1, 0x02) // Device Wake
        }

        \_SB.PCI0.LPCB.EC.ECSS = 0x00
        If (OSDW ()){}
        PWRS = \_SB.PCI0.LPCB.EC.EACP
        If (!OSDW ())
        {
            \_SB.PCI0.LPCB.EC.LWE0 = 0x00
            \_SB.PCI0.LPCB.EC.LWE1 = 0x00
            \_SB.PCI0.LPCB.EC.LWE2 = 0x00
            \_SB.PCI0.LPCB.EC.LWE3 = 0x00
            If ((Arg0 == 0x03))
            {
                \_SB.PCI0.PEG0.BR00.BR10.DTLK ()
                \_SB.PCI0.PEG0.BR00.BR11.DTLK ()
                \_SB.PCI0.PEG0.BR00.BR12.DTLK ()
            }

            If ((Arg0 == 0x04))
